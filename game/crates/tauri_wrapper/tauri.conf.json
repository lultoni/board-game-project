{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "(game-name)",
  "version": "0.1.0",
  "identifier": "com.elias.gamename",
  "build": {
    "frontendDist": "../../frontend/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "title": "(GAME NAME)",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
